# =============================================================================
# AI Trading Copilot — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.

# =============================================================================
# LLM CONFIGURATION
# =============================================================================

# Provider: openai | gemini
LLM_PROVIDER=openai

# OpenAI settings (if using OpenAI)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# Google Gemini settings (if using Gemini)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-pro

# =============================================================================
# DATABASE
# =============================================================================

DATABASE_URL=postgresql+asyncpg://trader:trader_pass@localhost:5432/trading_copilot

# For tests (SQLite in-memory)
TEST_DATABASE_URL=sqlite+aiosqlite:///:memory:

# =============================================================================
# BACKEND
# =============================================================================

SECRET_KEY=change-me-to-a-random-secret-in-production
BACKEND_CORS_ORIGINS=http://localhost:3000

# Auto-seed demo data on startup (true/false)
SEED_DEMO_DATA=true

# =============================================================================
# FRONTEND
# =============================================================================

NEXT_PUBLIC_API_URL=http://localhost:8000

# =============================================================================
# RISK ENGINE CONFIGURATION (optional overrides)
# =============================================================================

RISK_MAX_ORDER_VALUE=500000
RISK_MAX_QUANTITY=10000
RISK_MAX_DAILY_LOSS=-100000
RISK_MAX_POSITION_PCT=0.40
RISK_MAX_PRICE_DEVIATION=0.20

# =============================================================================
# MARKET DATA & STREAMING
# =============================================================================

MARKET_DATA_PROVIDER=simulator # simulator | groww
REDIS_URL=redis://localhost:6379/0

GROWW_API_KEY=your-api-key
GROWW_API_SECRET=your-api-secret
GROWW_TOTP_SECRET=your-totp-secret

# Seed for deterministic price generation (if simulator)
MARKET_SEED=42
# Tick interval in seconds (if simulator)
MARKET_TICK_INTERVAL=30
